# rocketchat-e2ee-mcp (rc-mcp) configuration. PLACEHOLDERS ONLY: never commit real values.
#
# rc-mcp does not read .env files itself. Copy this file to .env, fill it in, run `chmod 600 .env`,
# then load it into your shell before running rc-mcp or starting Claude Code:
#
#   set -a; . ./.env; set +a
#
# Alternatively, put the same settings in a JSON config file (mode 0600); see README "Configuration".
# Environment variables override the config file.

# --- Required -----------------------------------------------------------------------------------

# Rocket.Chat base URL. Use https; http is accepted for local testing but sends the token in cleartext.
RC_URL=https://chat.example.com

# Your user id. Rocket.Chat shows it ("Your user Id") together with the token when you create a
# Personal Access Token under My Account -> Personal Access Tokens.
RC_USER_ID=your-user-id

# Personal Access Token, created with "Ignore Two Factor Authentication" (otherwise calls can hit a
# 2FA challenge). It can do anything your account can: treat it like a password.
RC_AUTH_TOKEN=your-personal-access-token

# --- Needed for end-to-end encrypted rooms --------------------------------------------------------

# Your E2EE password (or the passphrase Rocket.Chat generated for you). Without it, encrypted rooms are
# listed but not decrypted. Keep the quotes if it contains spaces.
RC_E2EE_PASSWORD='your e2ee password or passphrase'

# --- Optional -----------------------------------------------------------------------------------

# Where the local index (PLAINTEXT of decrypted messages) and saved attachments live. Must be an absolute
# path; a leading ~ is expanded. Default: $XDG_DATA_HOME/rc-mcp, else ~/.local/share/rc-mcp
# RC_MCP_DATA_DIR=/path/to/a/private/directory

# 1, true, yes or on: keep the index in memory only and have get_file return attachments inline instead of
# saving them, so nothing is written to disk. Each start then syncs from scratch.
# RC_MCP_EPHEMERAL=1

# debug | info | warn | error | silent (default: info). Logs are JSON lines on stderr.
# RC_MCP_LOG_LEVEL=info

# Path to a JSON config file (keys: url, userId, authToken, e2eePassword, dataDir, ephemeral, logLevel).
# It must be mode 0600. Default: $XDG_CONFIG_HOME/rc-mcp/config.json, else ~/.config/rc-mcp/config.json
# (used only if it exists).
# RC_MCP_CONFIG=/path/to/config.json
